<section class="faq-section">
  <div class="faq-inner">
    <h2>{{ section.settings.heading }}</h2>

    {% for block in section.blocks %}
      <div class="faq-item" {{ block.shopify_attributes }}>
        <button class="faq-question">{{ block.settings.question }}</button>
        <div class="faq-answer">
          {{ block.settings.answer }}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question goes here?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Answer goes here.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How quickly will I see results?", "answer": "<p>Most golfers notice a significant reduction in their slice within the first practice session.</p>" } },
        { "type": "faq_item", "settings": { "question": "What if I'm a complete beginner?", "answer": "<p>This program works for all skill levels. Beginners often see the fastest results.</p>" } },
        { "type": "faq_item", "settings": { "question": "Is this a physical product or digital?", "answer": "<p>This is a 100% digital product. You'll get instant access to stream all video lessons on any device.</p>" } },
        { "type": "faq_item", "settings": { "question": "How long do I have access?", "answer": "<p>You get lifetime access. Watch the lessons as many times as you want.</p>" } },
        { "type": "faq_item", "settings": { "question": "What if it doesn't work for me?", "answer": "<p>We offer a full 60-day money-back guarantee. No questions asked.</p>" } }
      ]
    }
  ]
}
{% endschema %}
