<section class="guarantee">
  <div class="guarantee-inner">
    {% if section.settings.badge != blank %}
      {{ section.settings.badge | image_url: width: 200 | image_tag: class: 'guarantee-badge', alt: section.settings.heading }}
    {% endif %}
    <h2>{{ section.settings.heading }}</h2>
    {{ section.settings.body }}
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    {
      "type": "image_picker",
      "id": "badge",
      "label": "Guarantee badge image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "60-Day Money-Back Guarantee"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>Try the One Shot Slice Fix completely risk-free. If you don't see a noticeable improvement in your drives within 60 days, simply email us and we'll refund every penny — no questions asked.</p>"
    }
  ],
  "presets": [
    {
      "name": "Guarantee"
    }
  ]
}
{% endschema %}
