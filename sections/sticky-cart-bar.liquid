<div class="sticky-cart-bar" id="stickyCartBar">
  <span class="sticky-price">
    {{ product.price | money }}
    {% if product.compare_at_price > product.price %}
      <span class="original">{{ product.compare_at_price | money }}</span>
    {% endif %}
  </span>
  {%- form 'product', product -%}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <button type="submit" class="btn-sticky-cart"
      {% unless product.available %}disabled{% endunless %}>
      {{ 'general.add_to_cart' | t }}
    </button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Sticky Cart Bar",
  "settings": []
}
{% endschema %}
