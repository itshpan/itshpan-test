<div style="max-width:var(--max-width);margin:0 auto;padding:40px 24px;">
  <h1>{{ blog.title }}</h1>
  {% for article in blog.articles %}
    <article style="margin-bottom:32px;padding-bottom:32px;border-bottom:1px solid #e0e0e0;">
      <h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
      <p style="color:var(--color-text-muted);font-size:14px;">{{ article.published_at | date: '%B %d, %Y' }}</p>
      <p>{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p>
    </article>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": []
}
{% endschema %}
