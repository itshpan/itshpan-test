<section class="related-products">
  <div class="related-inner">
    <h2>{{ section.settings.heading }}</h2>
    <div class="related-grid">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          <a href="{{ product.url }}" class="related-card">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 400 | image_tag: alt: product.title }}
            {% endif %}
            <div class="related-card-body">
              <h4>{{ product.title }}</h4>
              <span class="related-price">
                {{ product.price | money }}
                {% if product.compare_at_price > product.price %}
                  <span class="original">{{ product.compare_at_price | money }}</span>
                {% endif %}
              </span>
            </div>
          </a>
        {% endfor %}
      {% else %}
        <p style="text-align:center;grid-column:1/-1;color:var(--color-text-muted);">Select a collection in the theme customizer.</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}
