{% schema %}
{
  "name": "Hero Test",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Hero Section"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Practice editing hero sections with Claude."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 40,
      "unit": "%"
    }
  ],
  "presets": [
    {
      "name": "Hero Test"
    }
  ]
}
{% endschema %}

<section style="position:relative;min-height:500px;display:flex;align-items:center;justify-content:center;overflow:hidden;">
  {% if section.settings.background_image != blank %}
    {{ section.settings.background_image | image_url: width: 1920 | image_tag: style: 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover;' }}
  {% endif %}
  <div style="position:absolute;inset:0;background:{{ section.settings.overlay_color }};opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
  <div style="position:relative;text-align:center;color:{{ section.settings.text_color }};padding:40px 24px;">
    <h1 style="font-size:48px;font-weight:900;text-transform:uppercase;margin-bottom:16px;">{{ section.settings.heading }}</h1>
    <p style="font-size:20px;margin-bottom:24px;opacity:0.9;">{{ section.settings.subheading }}</p>
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link }}" style="display:inline-block;padding:16px 40px;background:#ff4500;color:#fff;font-weight:800;text-transform:uppercase;border-radius:6px;text-decoration:none;">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>
</section>
