{% comment %}
  Renders star rating SVGs.
  Usage: {% render 'star-rating', rating: 4.8 %}
{% endcomment %}

{% assign full_stars = rating | floor %}
{% assign has_half = false %}
{% assign decimal = rating | minus: full_stars %}
{% if decimal >= 0.3 and decimal <= 0.7 %}
  {% assign has_half = true %}
{% elsif decimal > 0.7 %}
  {% assign full_stars = full_stars | plus: 1 %}
{% endif %}

{% for i in (1..5) %}
  {% if i <= full_stars %}
    <svg class="star" viewBox="0 0 20 19" fill="#FFB800"><polygon points="10,0 13,7 20,7 14,11 16,19 10,14 4,19 6,11 0,7 7,7"/></svg>
  {% elsif has_half and i == full_stars | plus: 1 %}
    <svg class="star" viewBox="0 0 20 19">
      <defs><linearGradient id="half"><stop offset="50%" stop-color="#FFB800"/><stop offset="50%" stop-color="#ddd"/></linearGradient></defs>
      <polygon points="10,0 13,7 20,7 14,11 16,19 10,14 4,19 6,11 0,7 7,7" fill="url(#half)"/>
    </svg>
  {% else %}
    <svg class="star" viewBox="0 0 20 19" fill="#ddd"><polygon points="10,0 13,7 20,7 14,11 16,19 10,14 4,19 6,11 0,7 7,7"/></svg>
  {% endif %}
{% endfor %}
